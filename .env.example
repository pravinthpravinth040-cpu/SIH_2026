# Backend-only configuration. Do not expose these values in the frontend or GitHub.
HOST=127.0.0.1
PORT=8000
API_KEY=replace_with_backend_api_key

# Supabase backend configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct PostgreSQL connection for server-side database access only.
# Replace with the actual Supabase database password before production use.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=oil_spill

# Existing project values
WEATHER_API_KEY=replace_with_weather_key
OCEANGUARD_API_KEY=replace_with_api_key
EXTERNAL_API_URL=https://api.example.com/data
EXTERNAL_API_KEY=your_api_key_here
EXTERNAL_API_AUTH_HEADER=Authorization
EXTERNAL_API_AUTH_SCHEME=Bearer
EXTERNAL_API_TIMEOUT_SECONDS=10
COPERNICUS_CLIENT_ID=your_client_id
COPERNICUS_CLIENT_SECRET=your_client_secret

AOI_MIN_LON=72.5
AOI_MIN_LAT=18.5
AOI_MAX_LON=73.5
AOI_MAX_LAT=19.5
COPERNICUS_START_DATE=2026-08-26T00:00:00Z
COPERNICUS_END_DATE=2026-08-27T23:59:59Z
